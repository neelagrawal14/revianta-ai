# Base URL for the Revianta AI FastAPI backend.
# Left unset, src/services/api.js falls back to "/api" (useful behind a
# dev-server proxy or a same-origin reverse proxy in production).
VITE_API_BASE_URL=http://localhost:8000

# --- Optional: only used by src/services/liveSearchApi.js -------------
# Both are optional. Without them, Live Search still works (Semantic
# Scholar and GitHub's public APIs need no key) but with lower rate
# limits. NEVER put a secret key here that must stay server-side (e.g. a
# Kaggle or PatentsView key) — anything prefixed VITE_ is bundled into
# the browser JS and is publicly visible.
VITE_SEMANTIC_SCHOLAR_API_KEY=
VITE_GITHUB_TOKEN=
